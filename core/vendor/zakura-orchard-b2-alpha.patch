+/// LOKI PATCH (B2) verification.
+///
+/// These live here rather than in the consuming crate because `SpendInfo::build` is
+/// private: the patch has to be observed where it is applied.
+#[cfg(test)]
+mod loki_b2_alpha {
+    use super::SpendInfo;
+    use crate::{
+        NoteVersion,
+        keys::{FullViewingKey, Scope, SpendingKey},
+        note::{Note, RandomSeed, Rho},
+        tree::MerklePath,
+        value::NoteValue,
+    };
+    use ff::Field;
+    use pasta_curves::pallas;
+    use rand::{rand_core::UnwrapErr, rngs::SysRng};
+
+    fn fixture() -> (FullViewingKey, Note, MerklePath, UnwrapErr<SysRng>) {
+        let mut rng = UnwrapErr(SysRng::default());
+        let sk = SpendingKey::from_bytes([11u8; 32]).unwrap();
+        let fvk = FullViewingKey::from(&sk);
+        let recipient = fvk.address_at(0u64, Scope::External);
+
+        let rho = Rho::from_bytes(&[0u8; 32]).unwrap();
+        let rseed = RandomSeed::from_bytes([5u8; 32], &rho).unwrap();
+        let note = Note::from_parts(
+            recipient,
+            NoteValue::from_raw(1_000),
+            rho,
+            rseed,
+            NoteVersion::V3,
+        )
+        .unwrap();
+
+        let path = MerklePath::dummy(&mut rng);
+        (fvk, note, path, rng)
+    }
+
+    /// The property ZIP 312 needs: the signer set agrees on alpha first, and the spend
+    /// the builder produces commits to exactly that value.
+    #[test]
+    fn rk_follows_the_caller_selected_alpha() {
+        let (fvk, note, path, mut rng) = fixture();
+        let alpha = pallas::Scalar::random(&mut rng);
+
+        let spend = SpendInfo::new_with_alpha(fvk.clone(), note, path, alpha)
+            .expect("the fvk owns the note");
+
+        let (_nf, ak, used_alpha, rk) = spend.build(&mut rng);
+
+        assert_eq!(used_alpha, alpha, "build() must use the alpha we chose");
+        assert_eq!(
+            <[u8; 32]>::from(&rk),
+            <[u8; 32]>::from(&ak.randomize(&alpha)),
+            "rk must equal ak randomized by that alpha"
+        );
+    }
+
+    /// Two builds of the same spend must agree, which upstream could not promise.
+    #[test]
+    fn a_chosen_alpha_is_deterministic_across_builds() {
+        let (fvk, note, path, mut rng) = fixture();
+        let alpha = pallas::Scalar::random(&mut rng);
+
+        let a = SpendInfo::new_with_alpha(fvk.clone(), note.clone(), path.clone(), alpha)
+            .unwrap()
+            .build(&mut rng);
+        let b = SpendInfo::new_with_alpha(fvk, note, path, alpha)
+            .unwrap()
+            .build(&mut rng);
+
+        assert_eq!(<[u8; 32]>::from(&a.3), <[u8; 32]>::from(&b.3));
+    }
+
+    /// And without one, upstream behaviour is unchanged: alpha is still sampled.
+    #[test]
+    fn without_a_chosen_alpha_the_builder_still_samples() {
+        let (fvk, note, path, mut rng) = fixture();
+
+        let a = SpendInfo::new(fvk.clone(), note.clone(), path.clone())
+            .unwrap()
+            .build(&mut rng);
+        let b = SpendInfo::new(fvk, note, path).unwrap().build(&mut rng);
+
+        assert_ne!(a.2, b.2, "two unset builds must not share an alpha");
+    }
+}
