+    /// LOKI PATCH (B2): as [`Self::add_ironwood_spend`], with a caller-selected spend
+    /// authorization randomizer.
+    ///
+    /// ZIP 312 requires every FROST signer to sign under the same `alpha`, and on Zcash
+    /// that value is fixed by the transaction rather than chosen by a coordinator. This
+    /// threads it to `orchard::builder::Builder::add_spend_unwitnessed_with_alpha`.
+    /// See `vendor/README.md`.
+    pub fn add_ironwood_spend_with_alpha<FE>(
+        &mut self,
+        fvk: orchard::keys::FullViewingKey,
+        note: orchard::Note,
+        alpha: pasta_curves::pallas::Scalar,
+    ) -> Result<(), Error<FE>> {
+        if note.version() != orchard::note::NoteVersion::V3 {
+            return Err(Error::IronwoodSpendUnsupportedNoteVersion(note.version()));
+        }
+        self.ironwood_builder
+            .add_spend_unwitnessed_with_alpha(fvk, note, alpha)
+            .map_err(Error::IronwoodSpend)
+    }
+
